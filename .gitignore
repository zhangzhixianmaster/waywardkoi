# ============================================================================
# waywardkoi .gitignore
#
# 用途：阻止密钥、凭据、构建产物与运行时状态进入版本库。
# 分三类：① 绝不可上传（密钥/凭据）② 构建产物 ③ 运行时状态
# ============================================================================

# ---------------------------------------------------------------------------
# ⓪ 隔离目录 —— 已移出的密钥与凭据都在这里，绝不可上传
#    注意：该目录位于仓库根目录【内部】，靠下面这条规则保护。
#    若你的 Git 客户端会无视 .gitignore（或你打算用网页端上传），
#    请把它移到仓库之外，例如 E:\waywardkoi_secrets
# ---------------------------------------------------------------------------
waywardkoi_secrets/

# ---------------------------------------------------------------------------
# ① 绝不可上传 —— 私钥（PEM "BEGIN PRIVATE KEY"，5 个文件，已验证）
#    一旦推送，等同泄露：ca.key 可签发任意客户端证书，client.key 可冒充设备
#    当前状态：已全部移入 ⓪ 的隔离目录
# ---------------------------------------------------------------------------
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.der
*.csr

# ---------------------------------------------------------------------------
# ② 绝不可上传 —— 含明文凭据的配置文件
#    auth_config.json:9,10,20,21 含阿里云 AccessKey ID + Secret（两处重复）
#    config.json:18-19 含 MQTT username/password
#    当前状态：已全部移入 ⓪ 的隔离目录，故仓库内已无这两个文件。
#    下方规则为纵深防御：日后若新建同名文件也不会误提交。
#    注意 auth.c:41 读取 /etc/auth_config.json、三个 Python 脚本读取
#    /etc/sms.conf —— 真实配置应部署到这两个路径，而不是留在源码树里。
# ---------------------------------------------------------------------------
workspace/admin_auth/file/auth_config.json
workspace/mqtt/file/config.json

# 允许上传的模板（脱敏后可提交，按需启用）
!workspace/admin_auth/file/auth_config.example.json
!workspace/mqtt/file/config.example.json

# ---------------------------------------------------------------------------
# ③ 构建产物 / 二进制 —— 不应入库，应可重现构建
#    configd、libcert_manager.so、-Wall（误命名的 ELF，见 docs §1.9 R7）
#    当前状态：已由使用者删除。下方规则防止重新构建后再被误提交。
# ---------------------------------------------------------------------------
workspace/configd/configd
workspace/admin_auth/-Wall
*.so
*.o
*.a
*.d
*.pyc
__pycache__/
lib*.so
lib*.so.*

# ---------------------------------------------------------------------------
# ④ 运行时状态 / 数据 —— 每台机器不同，且可能含设备隐私
# ---------------------------------------------------------------------------
*.log
logs/
/var/
/data/
/tmp/

# 运行时生成的状态文件
*.b64

# ---------------------------------------------------------------------------
# ⑤ 编辑器 / 系统 / 临时文件
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.idea/
.vscode/
*.bak
*.orig
*.rej
core
core.*
nohup.out

# ---------------------------------------------------------------------------
# ⑥ 说明：剩余文件当前状态与仍需人工处理的事项
#    www/            空目录，git 不跟踪空目录，需 .gitkeep 才会保留
#    docs/           要提交（本次生成的文档）
#    game.html       已确认无密钥、无后端地址，可安全上传
#    *.crt           公钥证书当前也一并移入隔离目录；如日后放回仓库，
#                    请确认是否愿意公开内部 CA 结构与设备标识
#
#  ⚠️ 仍需人工修改代码（.gitignore 无法拦截）：
#    workspace/admin_auth/auth.c:56
#        #define TOKEN_SECRET "your-secret-key-change-in-production-2025"
#    这是登录 Token 的 HMAC 签名密钥，硬编码在源码里。上传前必须改为从
#    /etc/ 或环境变量读取，否则任何人都能伪造登录 Token。
#    （调用点见 auth.c:889，Token 生成见 auth.c:883-892）
# ---------------------------------------------------------------------------
